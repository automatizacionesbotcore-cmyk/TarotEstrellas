APP_NAME=TarotEstrellas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Pagos actuales: PayPal + transferencia. Usar sandbox local y LIVE solo en produccion.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Stripe queda para compatibilidad legacy si existen pagos antiguos.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Flow.cl esta reservado para fase 2.
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_BASE_URL=https://www.flow.cl/api

# Daily.co: si DAILY_API_KEY queda vacio, el sistema opera en modo mock.
DAILY_API_KEY=
DAILY_DOMAIN=
DAILY_BASE_URL=https://api.daily.co/v1
DAILY_WEBHOOK_SECRET=
DAILY_ROOM_EXPIRY_MINUTES=90
DAILY_ENABLE_TRANSCRIPTION=true
DAILY_RECORDING_RETENTION_DAYS=90

# WhatsApp Meta/YCloud
WHATSAPP_PROVIDER=meta
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
YCLOUD_WEBHOOK_SECRET=

# IA
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
ANTHROPIC_API_KEY=
ANTHROPIC_SUMMARY_MODEL=claude-3-5-haiku-latest
ANTHROPIC_AGENT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_AGENT_MAX_SESIONES=20
ANTHROPIC_AGENT_MAX_TOKENS=1024

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
