<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Preflight CORS — Apache responde directo sin pasar a PHP
    RewriteCond %{REQUEST_METHOD} =OPTIONS
    RewriteRule .* - [R=204,L]
</IfModule>

<IfModule mod_headers.c>
    # CORS: refleja Origin si pertenece a la lista permitida (dev + prod)
    SetEnvIf Origin "^(https?://localhost(:\d+)?|https?://127\.0\.0\.1(:\d+)?|https://(www\.)?tarotestrellas\.com)$" CORS_ALLOW_ORIGIN=$0
    Header always set Access-Control-Allow-Origin "%{CORS_ALLOW_ORIGIN}e" env=CORS_ALLOW_ORIGIN
    Header always set Vary "Origin"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" "expr=%{REQUEST_STATUS} == 204"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, Accept, X-Requested-With, X-XSRF-TOKEN" "expr=%{REQUEST_STATUS} == 204"
    Header always set Access-Control-Allow-Credentials "true" env=CORS_ALLOW_ORIGIN
</IfModule>

<IfModule mod_rewrite.c>
    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
